{
  "manifest_version": 3,
  "name": "Tab Transcriber：錄音轉文字稿",
  "short_name": "Tab Transcriber",
  "version": "0.4.0",
  "description": "把分頁正在播放的英文、日文或泰文錄音轉成每句附時間的文字稿，可加上繁體中文雙語字幕。在這台電腦上轉文字和翻譯，聲音不會上傳。",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "tabCapture",
    "offscreen",
    "sidePanel",
    "storage",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "開始把這個分頁的錄音轉成文字稿",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
